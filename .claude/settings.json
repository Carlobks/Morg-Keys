{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/morg-keys/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(winget install *)",
      "PowerShell(winget install *)",
      "PowerShell(Install-Module *)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.githooks/**)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/testar.ps1)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$r/.claude/hooks/bloquear_arranque.py\" ] || r=\"$(git rev-parse --show-toplevel)\"; \"C:/Windows/py.exe\" -I \"$r/.claude/hooks/bloquear_arranque.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "A verificar a armadilha A2"
          },
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$r/.claude/hooks/guarda_do_git.py\" ] || r=\"$(git rev-parse --show-toplevel)\"; \"C:/Windows/py.exe\" -I \"$r/.claude/hooks/guarda_do_git.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "A verificar os portões do git"
          },
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$r/.claude/hooks/perguntar_antes.py\" ] || r=\"$(git rev-parse --show-toplevel)\"; \"C:/Windows/py.exe\" -I \"$r/.claude/hooks/perguntar_antes.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "A ver se é preciso o sim do dono"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$r/.claude/hooks/limite_de_linhas.py\" ] || r=\"$(git rev-parse --show-toplevel)\"; \"C:/Windows/py.exe\" -I \"$r/.claude/hooks/limite_de_linhas.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "A verificar o limite de 500 linhas"
          },
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$r/.claude/hooks/perguntar_antes.py\" ] || r=\"$(git rev-parse --show-toplevel)\"; \"C:/Windows/py.exe\" -I \"$r/.claude/hooks/perguntar_antes.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "A ver se é preciso o sim do dono"
          }
        ]
      }
    ]
  }
}
